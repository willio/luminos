<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.luminos.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/Will/Applications/Luminos.app/Contents/MacOS/Luminos</string>
		<string>--sync</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- restart only on abnormal exit; a clean quit (menu Quit / bootout with
	     exit 0) must stay dead, otherwise "Quit" relaunches after 30 s -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>/tmp/luminos.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/luminos.log</string>
</dict>
</plist>
